@model Application

<div class="container mt-4">
    <div class="text-center">
        <h1 class="mb-3">Add Movies</h1>
        <h3 class="mb-4">Use the form below to add a new movie to Joel's collection:</h3>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <form asp-action="Movies" asp-controller="Home" method="post">
                <!-- Category -->
                <div class="mb-3">
                    <label for="Category" class="form-label">Category</label>
                    <input type="text" class="form-control" id="Category" name="Category" placeholder="Enter movie category" required>
                </div>

                <!-- Title -->
                <div class="mb-3">
                    <label for="Title" class="form-label">Title</label>
                    <input type="text" class="form-control" id="Title" name="Title" placeholder="Enter movie title" required>
                </div>

                <!-- Year -->
                <div class="mb-3">
                    <label for="Year" class="form-label">Year</label>
                    <input type="text" class="form-control" id="Year" name="Year" placeholder="Enter release year" required>
                </div>

                <!-- Director -->
                <div class="mb-3">
                    <label for="Director" class="form-label">Director</label>
                    <input type="text" class="form-control" id="Director" name="Director" placeholder="Enter director's name" required>
                </div>

                <!-- Rating -->
                <div class="mb-3">
                    <label for="Rating" class="form-label">Rating</label>
                    <select class="form-select" id="Rating" name="Rating" required>
                        <option value="">Select rating</option>
                        <option>G</option>
                        <option>PG</option>
                        <option>PG-13</option>
                        <option>R</option>
                    </select>
                </div>

                <!-- Edited (Checkbox) -->
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="Edited" name="Edited">
                    <label class="form-check-label" for="Edited">Edited</label>
                </div>

                <!-- Lent To -->
                <div class="mb-3">
                    <label for="LentTo" class="form-label">Lent to</label>
                    <input type="text" class="form-control" id="LentTo" name="LentTo" placeholder="Enter name">
                </div>

                <!-- Notes -->
                <div class="mb-3">
                    <label for="Notes" class="form-label">Notes</label>
                    <textarea class="form-control" id="Notes" name="Notes" rows="3" placeholder="Enter notes" maxlength="25"></textarea>
                </div>

                <!-- Submit Button -->
                <div class="text-center">
                    <button type="submit" class="btn btn-primary">Add Movie</button>
                </div>
            </form>
        </div>
    </div>
</div>
