@model Movie

<div class="container mt-4">
    <div class="text-center">
        <h1 class="mb-3">@(Model.MovieId == 0 ? "Add Movie" : "Edit Movie")</h1>
        <h3 class="mb-4">Use the form below to @(Model.MovieId == 0 ? "add a new movie" : "update the movie") in Joel's collection:</h3>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <form asp-action="Movies" asp-controller="Home" method="post">
                <input type="hidden" asp-for="MovieId" required/> <!-- ✅ Keep MovieId for editing -->

                <!-- Category (Dropdown) -->
                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label">Category</label>
                    <select asp-for="CategoryId" class="form-control" asp-items="@(new SelectList(ViewBag.Categories, "CategoryId", "CategoryName"))" required>
                        <option value="">Select a category</option>
                    </select>
                </div>

                <!-- Title -->
                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" placeholder="Enter movie title" required>
                </div>

                <!-- Year -->
                <div class="mb-3">
                    <label asp-for="Year" class="form-label"></label>
                    <input asp-for="Year" class="form-control" placeholder="Enter release year" required>
                </div>

                <!-- Director -->
                <div class="mb-3">
                    <label asp-for="Director" class="form-label"></label>
                    <input asp-for="Director" class="form-control" placeholder="Enter director's name">
                </div>

                <!-- Rating -->
                <div class="mb-3">
                    <label asp-for="Rating" class="form-label"></label>
                    <select asp-for="Rating" class="form-select">
                        <option value="">Select rating</option>
                        @if (ViewBag.Ratings != null)
                        {
                            foreach (var rating in ViewBag.Ratings)
                            {
                                <option value="@rating">@rating</option>
                            }
                        }
                    </select>
                </div>

                <!-- Edited Checkbox -->
                <div class="form-check mb-3">
                    <input asp-for="Edited" class="form-check-input" type="checkbox" value="true">
                    <label asp-for="Edited" class="form-check-label">Edited</label>
                </div>

                <!-- Lent To -->
                <div class="mb-3">
                    <label asp-for="LentTo" class="form-label"></label>
                    <input asp-for="LentTo" class="form-control" placeholder="Enter name">
                </div>

                <!-- Copied to Plex Checkbox -->
                <div class="form-check mb-3">
                    <input asp-for="CopiedToPlex" class="form-check-input" type="checkbox" value="true">
                    <label asp-for="CopiedToPlex" class="form-check-label">Copied to Plex</label>
                </div>

                <!-- Notes -->
                <div class="mb-3">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Enter notes" maxlength="25"></textarea>
                </div>

                <!-- Submit Button -->
                <div class="text-center">
                    <button type="submit" class="btn btn-primary">
                        @(Model.MovieId == 0 ? "Add Movie" : "Update Movie")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
